<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast tests without Docker: the building blocks and the Orders module's domain and application layers. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Common\StranglerFig.Common.Application\StranglerFig.Common.Application.csproj" />
    <ProjectReference Include="..\..\src\Common\StranglerFig.Common.Infrastructure\StranglerFig.Common.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Common\StranglerFig.Common.Presentation\StranglerFig.Common.Presentation.csproj" />
    <ProjectReference Include="..\..\src\Modules\Orders\StranglerFig.Modules.Orders.Application\StranglerFig.Modules.Orders.Application.csproj" />
  </ItemGroup>

</Project>
