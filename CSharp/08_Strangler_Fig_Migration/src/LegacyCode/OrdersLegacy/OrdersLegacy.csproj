<?xml version="1.0" encoding="utf-8"?>
<!-- Classic (pre-SDK) project format on purpose - this is how a 2005-era project looks.
     Built with Mono's msbuild inside Docker, see Dockerfile. Not part of StranglerFig.slnx. -->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>OrdersLegacy</RootNamespace>
    <AssemblyName>OrdersLegacy</AssemblyName>
    <TargetFrameworkVersion>v2.0</TargetFrameworkVersion>
    <LangVersion>ISO-2</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="LegacyOrder.cs" />
    <Compile Include="OrderRepository.cs" />
    <Compile Include="OrdersHttpServer.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
