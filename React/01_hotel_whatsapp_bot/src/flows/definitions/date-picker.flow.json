{
  "name": "hotel-date-picker",
  "categories": ["APPOINTMENT_BOOKING"],
  "flow": {
    "version": "6.0",
    "data_api_version": "3.0",
    "routing_model": {
      "DATE_SELECTION": ["GUEST_COUNT"]
    },
    "screens": [
      {
        "id": "DATE_SELECTION",
        "title": "Dates de séjour",
        "terminal": false,
        "data": {},
        "layout": {
          "type": "SingleColumnLayout",
          "children": [
            {
              "type": "DatePicker",
              "name": "check_in",
              "label": "Arrivée",
              "min-date": "${data.today}",
              "required": true
            },
            {
              "type": "DatePicker",
              "name": "check_out",
              "label": "Départ",
              "min-date": "${form.check_in}",
              "required": true
            },
            {
              "type": "Footer",
              "label": "Continuer",
              "on-click-action": {
                "name": "navigate",
                "next": { "type": "screen", "name": "GUEST_COUNT" },
                "payload": {
                  "check_in": "${form.check_in}",
                  "check_out": "${form.check_out}"
                }
              }
            }
          ]
        }
      },
      {
        "id": "GUEST_COUNT",
        "title": "Nombre de voyageurs",
        "terminal": true,
        "data": {
          "check_in": { "type": "string", "__example__": "2025-06-01" },
          "check_out": { "type": "string", "__example__": "2025-06-05" }
        },
        "layout": {
          "type": "SingleColumnLayout",
          "children": [
            {
              "type": "TextInput",
              "input-type": "number",
              "name": "adults",
              "label": "Adultes",
              "required": true
            },
            {
              "type": "TextInput",
              "input-type": "number",
              "name": "children",
              "label": "Enfants",
              "required": false
            },
            {
              "type": "Footer",
              "label": "Voir les chambres",
              "on-click-action": {
                "name": "complete",
                "payload": {
                  "check_in": "${data.check_in}",
                  "check_out": "${data.check_out}",
                  "adults": "${form.adults}",
                  "children": "${form.children}"
                }
              }
            }
          ]
        }
      }
    ]
  }
}
